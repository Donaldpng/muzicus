{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUZICUS",
  "version": "0.1.0",
  "identifier": "com.muzicus.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MUZICUS",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#101013"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Free music player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMUQzQjhBRDJEQjU4NjYKUldSbVdOdlNpanNkWUJrdzdzZ1VKT3ZnTUt6NkxTMUc3NDFEajE2QmFHOGxUTmN3RU9aRmxScjQK",
      "endpoints": ["https://github.com/Donaldpng/muzicus/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
